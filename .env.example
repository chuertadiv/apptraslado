# Public values used by the PWA
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only values. Never expose these with a VITE_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-secret-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production email delivery
SUPABASE_AUTH_SMTP_HOST=
SUPABASE_AUTH_SMTP_PORT=587
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASSWORD=
